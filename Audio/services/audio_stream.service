[Unit]
Description=Virtual Lab - Audio Stream Service (Admin-Pi)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=%u
WorkingDirectory=%h/admin-pi
ExecStart=/usr/bin/python3 %h/admin-pi/Audio/server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Environment
Environment=PYTHONUNBUFFERED=1

# Hardening
ProtectSystem=full
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
