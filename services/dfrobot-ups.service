[Unit]
Description=DFRobot UPS Monitor Service (Admin-Pi)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=%u
WorkingDirectory=%h/admin-pi
ExecStart=/usr/bin/python3 %h/admin-pi/dfrobot_ups.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Environment
Environment=PYTHONUNBUFFERED=1

# Hardening
ProtectSystem=full
NoNewPrivileges=true
PrivateTmp=true

# Resource limits (optional)
MemoryMax=100M

[Install]
WantedBy=multi-user.target
